# Configuration for the claude-rc service.
# Installed to /etc/default/claude-rc. All values are optional.

# Directory Claude Code works in. Defaults to $HOME/work.
#CLAUDE_RC_WORKDIR=/home/claude/work

# Session name shown in claude.ai/code and the mobile app.
# Defaults to the hostname if unset.
#CLAUDE_RC_NAME=my-server

# Extra flags appended to `claude rc`, e.g. --spawn=worktree or --capacity 8.
# Deliberately does NOT default to --permission-mode bypassPermissions: this
# service takes instructions from the internet.
#CLAUDE_RC_FLAGS=--spawn=worktree

# Run under a pseudo-terminal via `script`. Turn this on only if something
# expects a rendered TUI - see the "Statusline and the rate-limit hook" section
# of the README. Requires the `script` binary (util-linux).
#CLAUDE_RC_PTY=on

# Path to the Claude Code binary, if it is not on PATH as `claude`.
#CLAUDE_BIN=/usr/bin/claude
