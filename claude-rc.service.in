[Unit]
Description=Claude Code Remote Control
After=network-online.target
Wants=network-online.target

# Never give up. A network or API outage makes every start fail with a connect
# timeout, and with a start limit systemd would park the unit in `failed` for
# good once the outage outlasts the burst. The fixed 60 s RestartSec below is
# what keeps this from being a crash loop against the API.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKDIR@

Environment=HOME=@HOME@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TERM=xterm-256color
EnvironmentFile=-/etc/default/claude-rc

ExecStart=/usr/local/bin/claude-rc-run

Restart=always
RestartSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-rc

# `claude rc` keeps redrawing its TUI, which is roughly 200 lines a minute of
# pure noise once the startup banner is out. Rate-limiting per unit keeps the
# banner (and any error burst) while stopping the steady stream from burying
# everything else in the journal. Raise the burst if you lose lines you need.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@HOME@
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
